# Скопируйте в .env и заполните нужные значения: cp .env.example .env
# Для запуска одного мессенджера достаточно заполнить только его секцию.

# ---------- Общие ----------
# polling — локальная отладка без белого IP (по умолчанию); webhook — продакшен с публичным HTTPS
BOT_MODE=polling
LOG_LEVEL=INFO
DATABASE_PATH=data/smart_bots.sqlite3

# ---------- Модерация ----------
# Файл со списком слов (синтаксис описан внутри файла)
MODERATION_KEYWORDS_FILE=config/moderation_keywords.txt
# Дополнительные слова через запятую: «*» — любые буквы, «!» — исключение
MODERATION_KEYWORDS=
# {user} заменяется на @username или имя нарушителя
MODERATION_WARNING_TEXT={user}, пожалуйста, не материтесь в чате, иначе будет бан.

# ---------- Claude API (/check) ----------
ANTHROPIC_API_KEY=
# Лимиты в Claude API считаются отдельно по каждой модели — укажите ту, расход которой хотите видеть
CLAUDE_MODEL=claude-opus-5-5

# ---------- Meme API (/mem) ----------
MEME_API_URL=https://meme-api.com/gimme
HTTP_TIMEOUT_SECONDS=15

# ---------- Вебхуки (BOT_MODE=webhook) ----------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Публичный HTTPS-адрес, по которому мессенджеры достучатся до бота
WEBHOOK_BASE_URL=
# Секрет для проверки входящих вебхуков (Telegram secret_token, MAX secret); латиница, цифры, _ и -
WEBHOOK_SECRET=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=

# ---------- MAX ----------
MAX_BOT_TOKEN=

# ---------- WhatsApp Cloud API ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Любая строка, которую вы укажете в Meta App Dashboard при подписке на вебхук
WHATSAPP_VERIFY_TOKEN=
# App Secret из настроек приложения Meta — для проверки подписи X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# ---------- Mattermost ----------
# Адрес сервера, например https://chat.example.com
MATTERMOST_URL=
MATTERMOST_TOKEN=
# Токен исходящего вебхука (только для BOT_MODE=webhook)
MATTERMOST_WEBHOOK_TOKEN=
